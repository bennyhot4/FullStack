# Cloudflare Pages response headers (plan 009).
# Hashed build output never changes under the same name, so browsers may keep it for a year.
/app/*
  Cache-Control: public, max-age=31536000, immutable

# These must always be revalidated so a deploy is picked up on the next load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# Plan 011: no page may be framed (clickjacking). Every page, not only /McpConsent: the SPA can reach the consent
# page by client-side navigation (e.g. /login?from=/McpConsent...), and then only the first document's headers count.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
